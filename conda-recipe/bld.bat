@echo on
rem Skip vcpkg: dependencies come from the conda environment.
set SKIP_VCPKG=ON
if "%EGTTOOLS_ENABLE_ARPACK%"=="" set EGTTOOLS_ENABLE_ARPACK=OFF
if "%EGTTOOLS_ENABLE_PETSC%"=="" set EGTTOOLS_ENABLE_PETSC=OFF
set "FEATURE_ARGS=-DEGTTOOLS_ENABLE_ARPACK=%EGTTOOLS_ENABLE_ARPACK% -DEGTTOOLS_ENABLE_PETSC=%EGTTOOLS_ENABLE_PETSC%"
set "CMAKE_ARGS=%CMAKE_ARGS% -DSKIP_VCPKG=ON -DCMAKE_PREFIX_PATH=%LIBRARY_PREFIX% %FEATURE_ARGS%"
set "EGTTOOLS_EXTRA_CMAKE_ARGS=-DCMAKE_PREFIX_PATH=%LIBRARY_PREFIX% %FEATURE_ARGS%"
"%PYTHON%" -m pip install . --no-build-isolation --no-deps -vv
if errorlevel 1 exit 1
