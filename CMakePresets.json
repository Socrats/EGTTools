{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja Multi-Config (vcpkg)",
      "description": "Configure with the bundled vcpkg toolchain and generate Ninja files for Debug and Release. CMake finds Python itself; set Python_EXECUTABLE to choose an interpreter.",
      "binaryDir": "${sourceDir}/builds/default",
      "generator": "Ninja Multi-Config",
      "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "BUILD_NUMERICAL_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "displayName": "Build (Debug)",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "default",
      "displayName": "Build (Release)",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "displayName": "C++ tests (Debug)",
      "configuration": "Debug",
      "filter": {"exclude": {"name": "PythonTests"}},
      "output": {"outputOnFailure": true}
    },
    {
      "name": "release",
      "configurePreset": "default",
      "displayName": "C++ tests (Release)",
      "configuration": "Release",
      "filter": {"exclude": {"name": "PythonTests"}},
      "output": {"outputOnFailure": true}
    }
  ]
}
